	/** \brief Create game. */
	func new(Desktop desktop) super(10, 30, 200, 200)
		runWhileBlockingLayout(block
			setTitle("DragonScript Testing")
			setCanMove(false)
			setCanClose(false)
			setCanMaximize(false)
			setCanMinimize(false)
			setCanResize(false)
			
			addWidget(Button.new("Borders", ActionWindowBorder.new(this)))
			addWidget(Button.new("Aspect Ratio", ActionWindowAspectRatio.new(this)))
			addWidget(Button.new("Scrollbars", ActionWindowScrollbar.new(this)))
			addWidget(Button.new("Lists", ActionWindowLists.new(this)))
			addWidget(Button.new("Canvas Paint", ActionWindowCanvasPaint.new(this)))
			addWidget(Button.new("Canvas View", ActionWindowCanvas.new(this)))
			addWidget(Button.new("Capture Canvas View", ActionWindowCaptureCanvas.new(this)))
			addWidget(Button.new("Image", ActionWindowImage.new(this)))
			addWidget(Button.new("Video Player", ActionWindowVideoPlayer.new(this)))
			addWidget(Button.new("Styled Text", ActionWindowStyledText.new(this)))
			addWidget(Button.new("Canvas Creator", ActionWindowCanvasCreator.new(this)))
			addWidget(Button.new("Layout Show-Case", ActionWindowLayouts.new(this)))
			addWidget(Button.new("Drag and Drop", ActionWindowDragDrop.new(this)))
			addWidget(Button.new("Gui Theme", ActionWindowGuiTheme.new(this)))
			addWidget(Button.new("Dynamic Music", ActionWindowDynamicMusic.new(this)))
			addWidget(Button.new("Announcer", ActionWindowAnnouncer.new(this)))
			addWidget(Button.new("Audio Capture", ActionWindowAudioCapture.new(this)))
			addWidget(Button.new("World Renderer", ActionWindowWorldRenderer.new(this)))
			addWidget(Button.new("Input Device", ActionWindowInputDevice.new(this)))
			addWidget(Button.new("Edit Bindings", ActionWindowEditBindings.new(this)))
			addWidget(Button.new("Edit Module Parameters", ActionWindowEditModuleParameters.new(this)))
			
			addWidget(Button.new("Quit", QuitGameActionListener.new()))
		end)
		
		desktop.addWindow(this)
		fitToContent()
	end
end
