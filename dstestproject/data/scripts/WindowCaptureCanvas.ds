pin Dragengine.Gui.Events
pin Dragengine.Gui.Borders
pin Dragengine.Gui.Layouts
pin Dragengine.Scenery
pin Dragengine.Utils



/**
 * \brief DragonScript test project capture canvas window.
 */
class WindowCaptureCanvas extends Window
	/** \brief Action capturing screen. */
	class ActionCaptureScreen extends DefaultActionListener
		/** \brief Capture canvas window. */
		var WindowCaptureCanvas pWindow
		
		/** \brief Create action. */
		func new(WindowCaptureCanvas window)
			pWindow = window
		end
		
		/** \brief Perform action. */
		func void onAction(ActionEvent event)
			pWindow.captureScreen()
		end
	end
	
	/** \brief Action capturing panel. */
	class ActionCapturePanel extends DefaultActionListener
		/** \brief Capture canvas window. */
		var WindowCaptureCanvas pWindow
		
		/** \brief Create action. */
		func new(WindowCaptureCanvas window)
			pWindow = window
		end
		
		/** \brief Perform action. */
		func void onAction(ActionEvent event)
			pWindow.capturePanel()
		end
	end
	
	/** \brief Capture timer. */
	class CaptureTimer extends Timer
		/** \brief Capture canvas window. */
		var WindowCaptureCanvas pWindow
		
		/** \brief Capture canvas to check. */
		var CaptureCanvas pCaptureCanvas
		
		/** \brief Create timer. */
		func new(WindowCaptureCanvas window, CaptureCanvas captureCanvas) super(0, true)
			pWindow = window
			pCaptureCanvas = captureCanvas
		end
		
		/** \brief Timer elapsed. */
		func void fire()
			pWindow.updateCapture(pCaptureCanvas)
		end
	end
	
	
	/** \brief Panel to capture. */
	var Panel pPanelCapture
	
	/** \brief Display captured image if present. */
	var DisplayImage pDisplayImage
	
	/** \brief Capture screen. */
	var CaptureCanvas pCaptureScreen
	
	/** \brief Capture panel. */
	var CaptureCanvas pCapturePanel
	
	/** \brief Capture timer. */
	var CaptureTimer pTimerCapture
	
	
	/** \brief Create game. */
	func new() super(0, 0, 650, 500)
		setDesignerSelector("WindowPadding")
		setTitle("Capture Canvas")
		
		createContent(this)
		
		// create capture canvas
		pCaptureScreen = CaptureCanvas.new()
		pCaptureScreen.setCanvasView(GraphicSystem.getPrimaryCanvas())
		
		pCapturePanel = CaptureCanvas.new()
		pCapturePanel.setCanvasView(pPanelCapture.getCanvasWidget())
	end
	
	/** \brief Dispose of widget. */
	func void dispose()
		stopTimer()
		
		pCapturePanel = null
		pCaptureScreen = null
		
		pDisplayImage = null
		pPanelCapture = null
		
		super.dispose()
	end
	
	
	/** \brief Capture screen. */
	func void captureScreen()
		if pCaptureScreen.getCapture()
			return
		end
		
		pCaptureScreen.setImage(GraphicSystem.getWindowWidth(), GraphicSystem.getWindowHeight(), 3, 8)
		pCaptureScreen.setCapture(true)
		
		startTimer(pCaptureScreen)
	end
	
	/** \brief Capture panel. */
	func void capturePanel()
		if pCapturePanel.getCapture()
			return
		end
		
		pCapturePanel.setImage(pPanelCapture.getWidth(), pPanelCapture.getHeight(), 3, 8)
		pCapturePanel.setCapture(true)
		
		startTimer(pCapturePanel)
	end
	
	/** \brief Update capture. */
	func void updateCapture(CaptureCanvas captureCanvas)
		if captureCanvas.getCapture()
			return
		end
		
		stopTimer()
		
		pDisplayImage.setImage(captureCanvas.getImage())
		captureCanvas.dropImage()
	end
	
	/** \brief Stop capture timer. */
	func void stopTimer()
		if pTimerCapture == null
			return
		end
		
		pTimerCapture.giveUp()
		pTimerCapture = null
	end
	
	/** \brief Start capture timer. */
	func void startTimer(CaptureCanvas captureCanvas)
		stopTimer()
		pTimerCapture = CaptureTimer.new(this, captureCanvas)
	end
	
	
	/** \brief Add content. */
	private func void createContent(Container content)
		var Point padding = Point.new(10, 10)
		var Point size = Point.new(200, 200)
		
		content.setLayout(BorderLayout.new())
		
		// real panel with active widgets. real panel requires a background canvas creator to
		// be present otherwise the copied content has artifacts. this happens because without
		// background canvas creator the area is undefined
		var Panel subPanel = Panel.new()
		subPanel.setLayout(FlowLayout.new(LayoutAxis.y))
		
		pPanelCapture = Panel.new()
		pPanelCapture.setLayout(FlowLayout.new(LayoutAxis.y, 3))
		pPanelCapture.setSize(size)
		pPanelCapture.setPosition(padding)
		pPanelCapture.setDesignerSelector("PanelWithBackground")
		
		var Label label = Label.new("Some sample text spawning multiple lines.")
		label.setMaximalWidth(200)
		label.setWordWrap(true)
		pPanelCapture.addWidget(label)
		pPanelCapture.addWidget(TextField.new(DefaultTextModel.new("Enter some text")))
		
		var Button button = Button.new("Screenshot Panel")
		button.addActionListener(ActionCapturePanel.new(this))
		pPanelCapture.addWidget(button)
		
		button = Button.new("Screenshow Screen")
		button.addActionListener(ActionCaptureScreen.new(this))
		pPanelCapture.addWidget(button)
		
		var TextArea textArea = TextArea.new(DefaultTextModel.new("Enter some text"))
		textArea.setMaximalWidth(50)
		textArea.setRowCount(5)
		pPanelCapture.addWidget(ScrollPanel.new(textArea))
		
		subPanel.addWidget(pPanelCapture)
		content.addWidget(subPanel, BorderLayout.Area.left)
		
		// captured image
		pDisplayImage = DisplayImage.new()
		var ScrollPanel scrollPanel = ScrollPanel.new(Viewport.new(pDisplayImage))
		scrollPanel.setDesignerSelector("CaptureScrollPanel")
		content.addWidget(scrollPanel, BorderLayout.Area.content)
	end
end
