pin Dragengine.Files
pin Dragengine.Gui.Borders
pin Dragengine.Gui.Events
pin Dragengine.Gui.StyledTextDefinitions
pin Dragengine.Gui.Layouts
pin Dragengine.Gui.Designers.Factories
pin Dragengine.LoadSave
pin Dragengine.Scenery
pin Dragengine.Utils.StyledText.Definition



/**
 * \brief DragonScript test project styled text window.
 */
class WindowStyledText extends Window
	/** \brief Named styled text. */
	class NamedStyledText
		/** \brief Name. */
		var String pName
		
		/** \brief Styled text. */
		var StyledTextDefinition pStyledText
		
		/** \brief Create named styled text. */
		func new(StyledTextDefinition styledText, String name)
			pName = name
			pStyledText = styledText
		end
		
		/** \brief Name. */
		func String getName()
			return pName
		end
		
		/** \brief Styled text. */
		func StyledTextDefinition getStyledText()
			return pStyledText
		end
		
		/** \brief String representation. */
		func String toString()
			return pName
		end
	end
	
	/** \brief Styled text selection listener. */
	class SelectionListenerStyledTextDefinition extends DefaultListModelListener
		/** \brief Window. */
		var WindowStyledText pWindow
		
		/** \brief Create selection listener. */
		func new(WindowStyledText window)
			pWindow = window
		end
		
		/** \brief Selection changed. */
		func void selectionChanged(ListModel listModel)
			pWindow.updateStyledText()
		end
	end
	
	/** \brief Page scroll listener. */
	class ScrollPage extends DefaultRangeModelListener
		/** \brief Window. */
		var WindowStyledText pWindow
		
		/** \brief Create selection listener. */
		func new(WindowStyledText window)
			pWindow = window
		end
		
		/** \brief Value changed. */
		func void valueChanged(RangeModel rangeModel)
			pWindow.updatePage()
		end
	end
	
	
	/** \brief Create window. */
	func new() super(0, 0, 600, 500)
		setDesignerSelector("WindowPadding")
		setTitle("Styled Text")
		
		pModelPage = DefaultRangeModel.new(0, 0, 1, 0, 1)
		pModelPage.addListener(ScrollPage.new(this))
		
		pModelStyledText = DefaultListModel.new()
		scanStyledText(TestProject.getApp().getLoaders().getStyledTextDefinition(), "/styledtext")
		
		createContent(this)
		
		if pModelStyledText.getCount() > 0
			pComboBoxStyledText.setSelectedElement(0)
			setStyledText((pModelStyledText.getAt(0) cast NamedStyledText).getStyledText())
		end
	end
	
	/** \brief Dispose of window. */
	func void dispose()
		pModelStyledText = null
		pComboBoxStyledText = null
		pModelPage = null
		pStyledText = null
		super.dispose()
	end
	
	
	/** \brief Styled text list model. */
	var DefaultListModel pModelStyledText
	
	/** \brief Styled text combo box. */
	var ComboBox pComboBoxStyledText
	
	/** \brief Display styled text. */
	var DisplayStyledText pStyledText
	
	/** \brief Page range model. */
	var DefaultRangeModel pModelPage
	
	
	/** \brief Update styled text. */
	func void updateStyledText()
		setStyledText((pModelStyledText.getAt(\
			pComboBoxStyledText.getSelectedElement()) cast NamedStyledText).getStyledText())
	end
	
	/** \brief Set styled text to display or \em null if not set. */
	func void setStyledText(StyledTextDefinition styledText)
		if styledText == pStyledText.getStyledTextDefinition()
			return
		end
		
		pStyledText.setStyledTextDefinition(styledText)
		pModelPage.setMaximum(DEMath.max(pStyledText.getPageCount() - 1, 0))
		pModelPage.setValue(0)
	end
	
	/** \brief Update page to display. */
	func void updatePage()
		if pModelPage.getMaximum() > 0
			pStyledText.setCurrentPage(pModelPage.getValue())
		end
	end
	
	/** \brief Scan directory for styled text and load them. */
	func void scanStyledText(LoadStyledTextDefinition loader, String directory)
		FileSystem.searchFiles(directory, true, block String each, FileType type
			if type == FileType.file and FileSystem.pathMatchesPattern(each, "*.xml")
				try
					pModelStyledText.add(NamedStyledText.new(loader.loadFromFile(each), \
						File.new(each).getName().substring(0, -4)))
					
				catch Exception e
					e.printTrace()
				end
			end
			return true
		end)
	end
	
	
	/** \brief Add content. */
	private func void createContent(Container content)
		content.setLayout(BorderLayout.new(5))
		
		// styled text selection
		var Panel panel = Panel.new()
		panel.setLayout(FlowLayout.new(LayoutAxis.x, 10, FlowLayout.Stretch.last))
		pComboBoxStyledText = ComboBox.new(pModelStyledText)
		pComboBoxStyledText.setSelectedElement(pModelStyledText.getCount() - 1)
		pComboBoxStyledText.setNumberDisplayLines(5)
		pModelStyledText.addListener(SelectionListenerStyledTextDefinition.new(this))
		panel.addWidget(Label.new("Styled Text:"))
		panel.addWidget(pComboBoxStyledText)
		content.addWidget(panel, BorderLayout.Area.top)
		
		// display with explicit background canvas creator
		pStyledText = DisplayStyledText.new()
		pStyledText.setDesignerSelector("DisplayStyledText")
		content.addWidget(pStyledText, BorderLayout.Area.content)
		
		// page scroll bar
		var ScrollBar scrollbar = ScrollBar.new(Orientation.vertical)
		scrollbar.setModel(pModelPage)
		content.addWidget(scrollbar, BorderLayout.Area.right)
	end
	
	
	/** \brief Size changed. */
	func void onResize(WidgetEvent event)
		super.onResize(event)
		
		pModelPage.setMaximum(DEMath.max(pStyledText.getPageCount() - 1, 0))
	end
end
