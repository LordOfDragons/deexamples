pin Dragengine.Gui.Borders
pin Dragengine.Gui.Events
pin Dragengine.Gui.Layouts
pin Dragengine.Scenery
pin Dragengine.Utils
pin Dragengine.LoadSave



/**
 * \brief DragonScript test project edit module parameters window.
 */
class WindowEditModuleParameters extends Window
	/** \brief Create window. */
	func new() super(0, 0, 500, 400)
		setDesignerSelector("WindowPadding")
		setTitle("Edit Module Parameters")
		
		runWhileBlockingLayout(block
			createContent(this)
		end)
	end
	
	/** \brief Dispose of window. */
	func void dispose()
		pPanelEditModuleParameters = null
		super.dispose()
	end
	
	
	var EditModuleParametersPanel pPanelEditModuleParameters
	
	
	/** \brief Create content. */
	private func void createContent(Container content)
		content.setLayout(BorderLayout.new(5))
		
		pPanelEditModuleParameters = EditModuleParametersPanel.new()
		addWidget(pPanelEditModuleParameters, BorderLayout.Area.content)
		
		addWidget(Panel.new(CentrizedBoxLayout.new(LayoutAxis.x, 20), block Panel panel
			panel.addWidget(Button.new("Apply Changes", \
				EditModuleParametersPanel.ActionApplyChanges.new(pPanelEditModuleParameters)))
			panel.addWidget(Button.new("Reset Changes", \
				EditModuleParametersPanel.ActionResetChanges.new(pPanelEditModuleParameters)))
		end), BorderLayout.Area.bottom)
	end
end
