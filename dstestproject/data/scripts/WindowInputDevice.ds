pin Dragengine.Gui.Borders
pin Dragengine.Gui.Events
pin Dragengine.Gui.Layouts
pin Dragengine.Scenery
pin Dragengine.Utils
pin Dragengine.LoadSave



/**
 * \brief DragonScript test project input device window.
 */
class WindowInputDevice extends Window
	/** \brief Input device renderer. */
	class InputDeviceRenderer extends DefaultListElementRenderer
		/** \brief Create renderer. */
		func new()
		end
		
		/** \brief Update renderer with object state. */
		func void updateRenderer(ListBox listBox, Widget renderer, Object element, \
		bool selected, bool focused)
			if element != null
				super.updateRenderer(listBox, renderer, \
					(element cast InputDevice).getName(), selected, focused)
				
			else
				super.updateRenderer(listBox, renderer, " ", selected, focused)
			end
		end
	end
	
	/** \brief Input device selection listener. */
	class SelectInputDevice extends DefaultListModelListener
		/** \brief Window. */
		var WindowInputDevice pWindow
		
		/** \brief Create selection listener. */
		func new(WindowInputDevice window)
			pWindow = window
		end
		
		/** \brief Selection changed. */
		func void selectionChanged(ListModel listModel)
			pWindow.setInputDevice(listModel.getAt(listModel.getSelected()) cast InputDevice)
		end
	end
	
	/** \brief Log message. */
	class LogMessage implements ConsoleListener
		func new()
		end
		
		func void messageAdded(Console console, ConsoleMessage message, bool removedTop)
			BaseGameApp.getApp().getConsole().addMessage(message.getMessage())
		end
		
		func void consoleCleared(Console console)
		end
	end
	
	/** \brief Auto-updating panel. */
	class AutoUpdatePanel extends Panel
		/** \brief Update timer. */
		class UpdateTimer extends Timer
			var AutoUpdatePanel pPanel
			
			func new(AutoUpdatePanel panel) super(0.0, true)
				pPanel = panel
			end
			
			func void fire()
				pPanel.updateState()
			end
		end
		
		/** \brief Update timer. */
		var UpdateTimer pUpdateTimer
		
		/** \brief Create renderer. */
		func new()
			pUpdateTimer = UpdateTimer.new(this)
		end
		
		/** \brief Dispose of window. */
		func void dispose()
			if pUpdateTimer != null
				pUpdateTimer.giveUp()
				pUpdateTimer = null
			end
			super.dispose()
		end
		
		/** \brief Update state. */
		func void updateState()
		end
	end
	
	/** \brief Input device axis renderer. */
	class InputDeviceAxisRenderer extends DefaultListElementRenderer
		/** \brief Create renderer. */
		func new()
		end
		
		/** \brief Create renderer. */
		func Widget createRenderer(ListBox listBox)
			return AxisPanel.new()
		end
		
		/** \brief Update renderer with object state. */
		func void updateRenderer(ListBox listBox, Widget renderer, Object element, \
		bool selected, bool focused)
			if element != null
				(renderer cast AxisPanel).setAxis(element cast InputDeviceAxis)
			end
		end
	end
	
	/** \brief Axis panel. */
	class AxisPanel extends AutoUpdatePanel
		private static fixed var WeightLayout.LayoutSettings column1 = WeightLayout.LayoutSettings.new(0, 100)
		private static fixed var WeightLayout.LayoutSettings column2 = WeightLayout.LayoutSettings.new(1)
		
		/** \brief Axis. */
		var InputDeviceAxis pAxis
		
		/** \brief Model name. */
		var TextModel pModelName
		
		/** \brief Model value. */
		var RangeModel pModelValue
		
		/** \brief Create axis panel. */
		func new()
			pModelName = DefaultTextModel.new("?: ")
			pModelValue = DefaultRangeModel.new(-100, 100, 10, 0, 1)
			
			setLayout(WeightLayout.new(LayoutAxis.x, 5))
			
			addWidget(Label.new(pModelName, Label.middleLeft), column1)
			addWidget(ProgressBar.new(Orientation.horizontal, pModelValue), column2)
		end
		
		/** \brief Set axis. */
		func void setAxis(InputDeviceAxis axis)
			pAxis = axis
			pModelName.setText(axis.getName())
		end
		
		/** \brief Update state. */
		func void updateState()
			pModelValue.setValue((pAxis.getValue() * 100.0) cast int)
		end
	end
	
	/** \brief Input device button renderer. */
	class InputDeviceButtonRenderer extends DefaultListElementRenderer
		/** \brief Create renderer. */
		func new()
		end
		
		/** \brief Create renderer. */
		func Widget createRenderer(ListBox listBox)
			return ButtonPanel.new()
		end
		
		/** \brief Update renderer with object state. */
		func void updateRenderer(ListBox listBox, Widget renderer, Object element, \
		bool selected, bool focused)
			if element != null
				(renderer cast ButtonPanel).setButton(element cast InputDeviceButton)
			end
		end
	end
	
	/** \brief Button panel. */
	class ButtonPanel extends AutoUpdatePanel
		private static fixed var WeightLayout.LayoutSettings column1 = WeightLayout.LayoutSettings.new(0, 100)
		private static fixed var WeightLayout.LayoutSettings column2 = WeightLayout.LayoutSettings.new(1)
		
		/** \brief Button. */
		var InputDeviceButton pButton
		
		/** \brief Model name. */
		var TextModel pModelName
		
		/** \brief Model value. */
		var RangeModel pModelValue
		
		/** \brief Create button panel. */
		func new()
			pModelName = DefaultTextModel.new("?: ")
			pModelValue = DefaultRangeModel.new(0, 1, 1, 0, 1)
			
			setLayout(WeightLayout.new(LayoutAxis.x, 5))
			
			addWidget(Label.new(pModelName, Label.middleLeft), column1)
			addWidget(ProgressBar.new(Orientation.horizontal, pModelValue), column2)
		end
		
		/** \brief Set button. */
		func void setButton(InputDeviceButton button)
			pButton = button
			pModelName.setText(button.getName())
		end
		
		/** \brief Update state. */
		func void updateState()
			if pButton.isPressed()
				pModelValue.setValue(1)
				
			else
				pModelValue.setValue(0)
			end
		end
	end
	
	
	/** \brief Create window. */
	func new() super(0, 0, 700, 500)
		pConsole = Console.new(20)
		pConsole.addListener(LogMessage.new())
		
		pModelInputDevices = DefaultListModel.new()
		pModelAxes = DefaultListModel.new()
		pModelButtons = DefaultListModel.new()
		
		setDesignerSelector("WindowPadding")
		setTitle("Input Device")
		createContent(this)
		updateInputDeviceModel()
	end
	
	/** \brief Dispose of window. */
	func void dispose()
		setInputDevice(null)
		
		pModelButtons = null
		pModelAxes = null
		pModelInputDevices = null
		pCBInputDevices = null
		pConsole = null
		
		super.dispose()
	end
	
	
	/** \brief Console. */
	var Console pConsole
	
	/** \brief Gui theme list model. */
	var DefaultListModel pModelInputDevices
	
	/** \brief Gui theme combo box. */
	var ComboBox pCBInputDevices
	
	/** \brief Active input device. */
	var InputDevice pInputDevice
	
	/** \brief Model axes. */
	var DefaultListModel pModelAxes
	
	/** \brief Model buttons. */
	var DefaultListModel pModelButtons
	
	
	
	/** \brief Create content. */
	private func void createContent(Container content)
		content.setLayout(BorderLayout.new(5))
		
		// input device selection
		var Panel panel = Panel.new()
		panel.setLayout(FlowLayout.new(LayoutAxis.x, 10, FlowLayout.Stretch.last))
		pCBInputDevices = ComboBox.new(pModelInputDevices, InputDeviceRenderer.new())
		pCBInputDevices.setNumberDisplayLines(5)
		pModelInputDevices.addListener(SelectInputDevice.new(this))
		panel.addWidget(Label.new("Input Device:"))
		panel.addWidget(pCBInputDevices)
		content.addWidget(panel, BorderLayout.Area.top)
		
		// content with list of axes and button states
		panel = Panel.new()
		panel.setLayout(BoxLayout.new(LayoutAxis.x, 10))
		content.addWidget(panel, BorderLayout.Area.content)
		
		// left side list of axes
		var Panel subPanel = Panel.new()
		subPanel.setLayout(BorderLayout.new(3))
		subPanel.addWidget(Label.new("Axes (absolute)", Label.center), BorderLayout.Area.top)
		
		var ListBox listBox = ListBox.new(pModelAxes, InputDeviceAxisRenderer.new())
		subPanel.addWidget(ScrollPanel.new(listBox), BorderLayout.Area.content)
		
		panel.addWidget(subPanel)
		
		// right side list of buttons
		subPanel = Panel.new()
		subPanel.setLayout(BorderLayout.new(3))
		subPanel.addWidget(Label.new("Buttons (no keys)", Label.center), BorderLayout.Area.top)
		
		listBox = ListBox.new(pModelButtons, InputDeviceButtonRenderer.new())
		//listBox.setNumberDisplayLines(1)
		//listBox.setType(ListBox.Type.verticalWrap)
		subPanel.addWidget(ScrollPanel.new(listBox), BorderLayout.Area.content)
		
		panel.addWidget(subPanel)
	end
	
	/** \brief Update input device list. */
	func void updateInputDeviceModel()
		var int count = InputSystem.getDeviceCount()
		var int i
		
		pModelInputDevices.removeAll()
		for i = 0 to count
			pModelInputDevices.add(InputSystem.getDeviceAt(i))
		end
		
		pCBInputDevices.setSelectedElement(0)
		setInputDevice(pModelInputDevices.getAt(0) cast InputDevice)
	end
	
	/** \brief Set input device to show. */
	func void setInputDevice(InputDevice inputDevice)
		if inputDevice == pInputDevice
			return
		end
		
		pInputDevice = inputDevice
		
		pModelAxes.removeAll()
		pModelButtons.removeAll()
		
		if inputDevice == null
			return
		end
		
		select inputDevice.getType()
		case InputDeviceType.keyboard
			return // has lots of keys (buttons). show nothing
		end
		
		runWhileBlockingLayout(block
			var InputDeviceAxis axis
			var Array list
			var int i, count
			
			list = Array.new()
			count = inputDevice.getAxisCount()
			for i = 0 to count
				axis = inputDevice.getAxisAt(i)
				select axis.getType()
				case InputDeviceAxisType.mouse, InputDeviceAxisType.mouseWheel
					// not showing absolute axes
				else
					list.add(axis)
				end
			end
			pModelAxes.addAll(list) // causes only one notification not many
			
			list.removeAll()
			count = inputDevice.getButtonCount()
			for i = 0 to count
				pModelButtons.add(inputDevice.getButtonAt(i))
			end
			pModelButtons.addAll(list) // causes only one notification not many
		end)
	end
end
