pin Dragengine.Audio.Announcer
pin Dragengine.Files
pin Dragengine.Gui.Borders
pin Dragengine.Gui.Events
pin Dragengine.Gui.Layouts
pin Dragengine.Preloading
pin Dragengine.Scenery
pin Dragengine.Utils



/**
 * \brief DragonScript test project announcer window.
 */
class WindowAnnouncer extends Window
	/** \brief Announcer list selection listener. */
	private class SelectAnnouncerListener extends DefaultListModelListener
		/** \brief Window. */
		var WindowAnnouncer pWindow
		
		/** \brief Create timer. */
		func new(WindowAnnouncer window)
			pWindow = window
		end
		
		/** \brief Selection changed. */
		func void selectionChanged(ListModel listModel)
			var int selection = listModel.getSelected()
			if selection != -1
				pWindow.setAnnouncer((listModel.getAt(selection) cast NamedAnnouncer).getAnnouncer())
			end
		end
	end
	
	/** \brief Play action. */
	private class PlayAction extends DefaultActionListener
		/** \brief Window. */
		var WindowAnnouncer pWindow
		
		/** \brief Create action. */
		func new(WindowAnnouncer window)
			pWindow = window
		end
		
		/** \brief Do action. */
		func void onAction(ActionEvent event)
			pWindow.play()
		end
	end
	
	/** \brief Stop action. */
	private class StopAction extends DefaultActionListener
		/** \brief Window. */
		var WindowAnnouncer pWindow
		
		/** \brief Create action. */
		func new(WindowAnnouncer window)
			pWindow = window
		end
		
		/** \brief Do action. */
		func void onAction(ActionEvent event)
			pWindow.stop()
		end
	end
	
	/** \brief Announcer wrapped with display name for list use. */
	private class NamedAnnouncer
		/** \brief Announcer. */
		var Announcer pAnnouncer
		
		/** \brief Name to display in list. */
		var String pName
		
		/** \brief Create named announcer. */
		func new(Announcer announcer, String name)
			pAnnouncer = announcer
			pName = name
		end
		
		/** \brief Announcer. */
		func Announcer getAnnouncer()
			return pAnnouncer
		end
		
		/** \brief String representation. */
		func String toString()
			return pName
		end
	end
	
	/** \brief Preloading announcer finished. */
	private class PreloadAnnouncerFinished extends DefaultPreloadListener
		/** \brief Window. */
		var WindowAnnouncer pWindow
		
		/** \brief Named announcer. */
		var NamedAnnouncer pAnnouncer
		
		/** \brief Create listener. */
		func new(WindowAnnouncer window, NamedAnnouncer announcer)
			pWindow = window
			pAnnouncer = announcer
		end
		
		/** \brief Preloading of all resources finished. */
		func void preloadingFinished(Preloader preloader, bool success)
			if success
				pWindow.addAnnouncer(pAnnouncer) 
			end
		end
	end
	
	
	/** \brief Announcer or \em null if not set. */
	var Announcer pAnnouncer
	
	/** \brief Announcer list model. */
	var DefaultListModel pModelAnnouncer
	
	/** \brief Announcer list. */
	var ListBox pListAnnouncer
	
	/** \brief Announcer part list model. */
	var DefaultListModel pModelPart
	
	/** \brief Announcer part list. */
	var ListBox pListPart
	
	/** \brief Announcer text model. */
	var TextModel pModelAnnounceText
	
	/** \brief Microphone. */
	var Microphone pMicrophone
	
	
	/** \brief Create window. */
	func new() super(0, 0, 400, 400)
		setTitle("Announcer")
		
		pMicrophone = Microphone.new()
		AudioSystem.setActiveMicrophone(pMicrophone)
	
		pModelAnnounceText = DefaultTextModel.new("")
		
		pModelAnnouncer = DefaultListModel.new()
		scanAnnouncer(TestProject.getApp().getLoaders().getAnnouncer(), "/announcer")
		
		pModelPart = DefaultListModel.new()
		
		createContent()
		
		if pModelAnnouncer.getCount() > 0
			pListAnnouncer.setSelectedElement(0)
			setAnnouncer((pModelAnnouncer.getAt(0) cast NamedAnnouncer).getAnnouncer())
		end
	end
	
	/** \brief Dispose of window. */
	func void dispose()
		super.dispose()
		
		pAnnouncer = null
		
		pModelAnnounceText = null
		pListPart = null
		pModelPart = null
		pListAnnouncer = null
		pModelAnnouncer = null
		
		if pMicrophone != null
			if pMicrophone.equals(AudioSystem.getActiveMicrophone())
				AudioSystem.setActiveMicrophone(null)
			end
			pMicrophone = null
		end
	end
	
	
	/** \brief Play selected announcer. */
	func void play()
		if pAnnouncer == null
			return
		end
		
		var String announceText = pModelAnnounceText.getText()
		if announceText.empty()
			return
		end
		
		pAnnouncer.setAnnounceFromText(announceText)
		pAnnouncer.play()
	end
	
	/** \brief Stop selected announcer. */
	func void stop()
		if pAnnouncer == null
			return
		end
		
		pAnnouncer.stop()
	end
	
	
	/** \brief Scan directory for announcer and load them. */
	func void scanAnnouncer(LoadAnnouncer loader, String directory)
		FileSystem.searchFiles(directory, true, block String each, FileType type
			if type == FileType.file and FileSystem.pathMatchesPattern(each, "*.deann")
				try
					// this version would load synchronously
					//pModelAnnouncer.add(NamedAnnouncer.new(\
					//	loader.loadFromFile(each), File.new(each).getName().substring(0, -13)))
					
					// this version loads asynchronously. using preloaders is prefered over synchronous
					// loading since this allows the game engine to load multiple resource efficiently
					// in parallel and the gui does not block until loading finished
					var PreloadAnnouncer preloader = loader.loadFromFileAsync(each, null)
					preloader.addListener(PreloadAnnouncerFinished.new(this, NamedAnnouncer.new(\
						preloader.getAnnouncer(), File.new(each).getName().substring(0, -6))))
					preloader.checkFinished()
					
				catch Exception e
					e.printTrace()
				end
			end
			return true
		end)
	end
	
	/** \brief Add announcer. */
	func void addAnnouncer(NamedAnnouncer announcer)
		// can be called by preloaders after window has been disposed so check this
		if pModelAnnouncer == null
			return
		end
		
		pModelAnnouncer.add(announcer)
	end
	
	/** \brief Set announcer to play or \em null if not set. */
	func void setAnnouncer(Announcer announcer)
		if announcer == pAnnouncer
			return
		end
		
		if pAnnouncer != null
			pMicrophone.removeSpeaker(pAnnouncer.getSpeaker())
			pAnnouncer.stop()
		end
		
		pAnnouncer = announcer
		updateParts()
		
		if announcer != null
			pMicrophone.addSpeaker(announcer.getSpeaker())
		end
	end
	
	/** \brief Create content. */
	private func void createContent()
		setLayout(BorderLayout.new(5))
		setDesignerSelector("WindowPadding")
		
		// announcer based widgets
		var Panel panelAnnouncer = Panel.new()
		panelAnnouncer.setLayout(BorderLayout.new(5))
		addWidget(panelAnnouncer, BorderLayout.Area.content)
		
		// announcer selector
		pListAnnouncer = ListBox.new(pModelAnnouncer)
		pListAnnouncer.setDesignerSelector("ListBox.Announcers")
		var ScrollPanel scrollPanelAnnouncer = ScrollPanel.new(pListAnnouncer)
		panelAnnouncer.addWidget(scrollPanelAnnouncer, BorderLayout.Area.left)
		pModelAnnouncer.addListener(SelectAnnouncerListener.new(this))
		
		// part list of selected announcer
		pListPart = ListBox.new(pModelPart)
		var ScrollPanel scrollPanelPart = ScrollPanel.new(pListPart)
		panelAnnouncer.addWidget(scrollPanelPart, BorderLayout.Area.content)
		
		// announce text
		var Panel panelAnnounceText = Panel.new()
		panelAnnounceText.setLayout(BorderLayout.new(5))
		panelAnnouncer.addWidget(panelAnnounceText, BorderLayout.Area.bottom)
		panelAnnounceText.addWidget(Label.new("Text:"), BorderLayout.Area.left)
		panelAnnounceText.addWidget(TextField.new(pModelAnnounceText), BorderLayout.Area.content)
		
		// button line
		var Panel panelButtons = Panel.new()
		panelButtons.setLayout(BoxLayout.new(LayoutAxis.x, 5))
		
		var Button button = Button.new("Play")
		button.addActionListener(PlayAction.new(this))
		panelButtons.addWidget(button)
		
		button = Button.new("Stop")
		button.addActionListener(StopAction.new(this))
		panelButtons.addWidget(button)
		
		button = Button.new("Close")
		button.addActionListener(CloseWindowActionListener.new(this))
		panelButtons.addWidget(button)
		
		addWidget(panelButtons, BorderLayout.Area.bottom)
	end
	
	/** \brief Update parts. */
	func void updateParts()
		if pAnnouncer == null
			pModelPart.removeAll()
			return
		end
		
		var Array parts = Array.new()
		pAnnouncer.forEachPart(block AnnouncerPart each
			parts.add(each.getID())
		end)
		parts.sort()
		pModelPart.setContent(parts)
	end
end
