pin Dragengine.Audio.DynamicMusic
pin Dragengine.Files
pin Dragengine.Gui.Borders
pin Dragengine.Gui.Events
pin Dragengine.Gui.Layouts
pin Dragengine.Preloading
pin Dragengine.Scenery
pin Dragengine.Utils



/**
 * \brief DragonScript test project dynamic music window.
 */
class WindowDynamicMusic extends Window
	/** \brief Update timer. */
	private class UpdateTimer extends Timer
		/** \brief Window. */
		var WindowDynamicMusic pWindow
		
		/** \brief Create timer. */
		func new(WindowDynamicMusic window) super(0.0, true)
			pWindow = window
		end
		
		/** \brief Timer fired. */
		func void fire()
			pWindow.update()
		end
	end
	
	/** \brief Dynamic music list selection listener. */
	private class SelectDynamicMusicListener extends DefaultListModelListener
		/** \brief Window. */
		var WindowDynamicMusic pWindow
		
		/** \brief Create timer. */
		func new(WindowDynamicMusic window)
			pWindow = window
		end
		
		/** \brief Selection changed. */
		func void selectionChanged(ListModel listModel)
			var int selection = listModel.getSelected()
			if selection != -1
				pWindow.setDynamicMusic((listModel.getAt(selection) cast NamedDynamicMusic).getDynamicMusic())
			end
		end
	end
	
	/** \brief Toggle switch action. */
	private class ToggleSwitchAction extends DefaultActionListener
		/** \brief Switch to toggle. */
		var DynamicMusicSwitch pSwitch
		
		/** \brief Create action. */
		func new(DynamicMusicSwitch switch)
			pSwitch = switch
		end
		
		/** \brief Do action. */
		func void onAction(ActionEvent event)
			pSwitch.setState(not pSwitch.getState())
		end
	end
	
	/** \brief Play action. */
	private class PlayAction extends DefaultActionListener
		/** \brief Window. */
		var WindowDynamicMusic pWindow
		
		/** \brief Create action. */
		func new(WindowDynamicMusic window)
			pWindow = window
		end
		
		/** \brief Do action. */
		func void onAction(ActionEvent event)
			pWindow.play()
		end
	end
	
	/** \brief Stop action. */
	private class StopAction extends DefaultActionListener
		/** \brief Window. */
		var WindowDynamicMusic pWindow
		
		/** \brief Create action. */
		func new(WindowDynamicMusic window)
			pWindow = window
		end
		
		/** \brief Do action. */
		func void onAction(ActionEvent event)
			pWindow.stop()
		end
	end
	
	/** \brief Dynamic music wrapped with display name for list use. */
	private class NamedDynamicMusic
		/** \brief Dynamic music. */
		var DynamicMusic pDynamicMusic
		
		/** \brief Name to display in list. */
		var String pName
		
		/** \brief Create named dynamic music. */
		func new(DynamicMusic dynamicMusic, String name)
			pDynamicMusic = dynamicMusic
			pName = name
		end
		
		/** \brief Dynamic music. */
		func DynamicMusic getDynamicMusic()
			return pDynamicMusic
		end
		
		/** \brief String representation. */
		func String toString()
			return pName
		end
	end
	
	/** \brief Preloading dynamic music finished. */
	private class PreloadDynamicMusicFinished extends DefaultPreloadListener
		/** \brief Window. */
		var WindowDynamicMusic pWindow
		
		/** \brief Named dynamic music. */
		var NamedDynamicMusic pDynamicMusic
		
		/** \brief Create listener. */
		func new(WindowDynamicMusic window, NamedDynamicMusic dynamicMusic)
			pWindow = window
			pDynamicMusic = dynamicMusic
		end
		
		/** \brief Preloading of all resources finished. */
		func void preloadingFinished(Preloader preloader, bool success)
			if success
				pWindow.addDynamicMusic(pDynamicMusic) 
			end
		end
	end
	
	
	/** \brief Dynamic music or \em null if not set. */
	var DynamicMusic pDynamicMusic
	
	/** \brief Update timer for dynamic music or \em null if not set. */
	var UpdateTimer pUpdateTimer
	
	/** \brief Dynamic music list model. */
	var DefaultListModel pModelDynamicMusic
	
	/** \brief Dynamic music list. */
	var ListBox pListDynamicMusic
	
	/** \brief Panel switches. */
	var Panel pPanelSwitches
	
	/** \brief Playing part model. */
	var TextModel pModelPlayingPart
	
	/** \brief Playing part. */
	var DynamicMusicPart pPlayingPart
	
	/** \brief Microphone. */
	var Microphone pMicrophone
	
	
	/** \brief Create window. */
	func new() super(0, 0, 400, 250)
		setDesignerSelector("WindowPadding")
		setTitle("Dynamic Music")
		
		pMicrophone = Microphone.new()
		AudioSystem.setActiveMicrophone(pMicrophone)
	
		pModelPlayingPart = DefaultTextModel.new("-")
		
		pModelDynamicMusic = DefaultListModel.new()
		scanDynamicMusic(TestProject.getApp().getLoaders().getDynamicMusic(), "/dynmusic")
		
		createContent()
		
		if pModelDynamicMusic.getCount() > 0
			pListDynamicMusic.setSelectedElement(0)
			setDynamicMusic((pModelDynamicMusic.getAt(0) cast NamedDynamicMusic).getDynamicMusic())
		end
		
		pUpdateTimer = UpdateTimer.new(this)
	end
	
	/** \brief Dispose of window. */
	func void dispose()
		super.dispose()
		
		if pUpdateTimer != null
			pUpdateTimer.giveUp()
			pUpdateTimer = null
		end
		pDynamicMusic = null
		
		pModelPlayingPart = null
		pPlayingPart = null
		pPanelSwitches = null
		pListDynamicMusic = null
		pModelDynamicMusic = null
		
		if pMicrophone != null
			if pMicrophone.equals(AudioSystem.getActiveMicrophone())
				AudioSystem.setActiveMicrophone(null)
			end
			pMicrophone = null
		end
	end
	
	
	/** \brief Update in regular intervals. */
	func void update()
		if pDynamicMusic == null
			return
		end
		pDynamicMusic.update()
		
		var DynamicMusicPart part = pDynamicMusic.getCurPart()
		if part != pPlayingPart
			pPlayingPart = part
			
			if pPlayingPart == null
				pModelPlayingPart.setText("-")
				
			else
				pModelPlayingPart.setText(part.getName())
			end
		end
	end
	
	/** \brief Play selected dynamic music. */
	func void play()
		if pDynamicMusic == null
			return
		end
		
		pDynamicMusic.play()
		
		pPlayingPart = pDynamicMusic.getCurPart()
		
		if pPlayingPart == null
			pModelPlayingPart.setText("-")
			
		else
			pModelPlayingPart.setText(pPlayingPart.getName())
		end
	end
	
	/** \brief Stop selected dynamic music. */
	func void stop()
		if pDynamicMusic == null
			return
		end
		
		pDynamicMusic.stop()
		
		pPlayingPart = null
		pModelPlayingPart.setText("-")
	end
	
	
	/** \brief Scan directory for dynamic music and load them. */
	func void scanDynamicMusic(LoadDynamicMusic loader, String directory)
		FileSystem.searchFiles(directory, true, block String each, FileType type
			if type == FileType.file and FileSystem.pathMatchesPattern(each, "*.dedm")
				try
					// this version would load synchronously
					//pModelDynamicMusic.add(NamedDynamicMusic.new(\
					//	loader.loadFromFile(each), File.new(each).getName().substring(0, -13)))
					
					// this version loads asynchronously. using preloaders is prefered over synchronous
					// loading since this allows the game engine to load multiple resource efficiently
					// in parallel and the gui does not block until loading finished
					var PreloadDynamicMusic preloader = loader.loadFromFileAsync(each, null)
					preloader.addListener(PreloadDynamicMusicFinished.new(this, NamedDynamicMusic.new(\
						preloader.getDynamicMusic(), File.new(each).getName().substring(0, -5))))
					preloader.checkFinished()
					
				catch Exception e
					e.printTrace()
				end
			end
			return true
		end)
	end
	
	/** \brief Add dynamic music. */
	func void addDynamicMusic(NamedDynamicMusic dynamicMusic)
		// can be called by preloaders after window has been disposed so check this
		if pModelDynamicMusic == null
			return
		end
		
		pModelDynamicMusic.add(dynamicMusic)
	end
	
	/** \brief Set dynamic music to play or \em null if not set. */
	func void setDynamicMusic(DynamicMusic dynamicMusic)
		if dynamicMusic == pDynamicMusic
			return
		end
		
		if pDynamicMusic != null
			pMicrophone.removeSpeaker(pDynamicMusic.getSpeaker())
			pDynamicMusic.stop()
		end
		
		pDynamicMusic = dynamicMusic
		
		if dynamicMusic != null
			pMicrophone.addSpeaker(dynamicMusic.getSpeaker())
		end
		
		updateSwitches()
	end
	
	/** \brief Create content. */
	private func void createContent()
		setLayout(BorderLayout.new(5))
		
		// dynamic music selector
		pListDynamicMusic = ListBox.new(pModelDynamicMusic)
		pListDynamicMusic.setDesignerSelector("ListBox.DynamicMusic")
		var ScrollPanel scrollPanelMusic = ScrollPanel.new(pListDynamicMusic)
		addWidget(scrollPanelMusic, BorderLayout.Area.left)
		pModelDynamicMusic.addListener(SelectDynamicMusicListener.new(this))
		
		// switch list with currently playing part below it
		var Panel panelSwitchesPart = Panel.new()
		panelSwitchesPart.setLayout(BorderLayout.new(5))
		addWidget(panelSwitchesPart, BorderLayout.Area.content)
		
		pPanelSwitches = Panel.new()
		pPanelSwitches.setLayout(FlowLayout.new(LayoutAxis.y, 5))
		var ScrollPanel scrollPanelSwitches = ScrollPanel.new(Viewport.new(pPanelSwitches))
		panelSwitchesPart.addWidget(scrollPanelSwitches, BorderLayout.Area.content)
		
		var Panel panelPart = Panel.new()
		panelPart.setLayout(BorderLayout.new(5))
		panelSwitchesPart.addWidget(panelPart, BorderLayout.Area.bottom)
		panelPart.addWidget(Label.new("Part:"), BorderLayout.Area.left)
		panelPart.addWidget(Label.new(pModelPlayingPart), BorderLayout.Area.content)
		
		// button line
		var Panel panelButtons = Panel.new()
		panelButtons.setLayout(BoxLayout.new(LayoutAxis.x, 5))
		
		var Button button = Button.new("Play")
		button.addActionListener(PlayAction.new(this))
		panelButtons.addWidget(button)
		
		button = Button.new("Stop")
		button.addActionListener(StopAction.new(this))
		panelButtons.addWidget(button)
		
		button = Button.new("Close")
		button.addActionListener(CloseWindowActionListener.new(this))
		panelButtons.addWidget(button)
		
		addWidget(panelButtons, BorderLayout.Area.bottom)
	end
	
	/** \brief Update switches. */
	func void updateSwitches()
		pPanelSwitches.removeAllWidgets()
		
		if pDynamicMusic == null
			return
		end
		
		pDynamicMusic.forEachSwitch(block DynamicMusicSwitch each
			each.setState(false) // start with off state
			var CheckBox checkBox = CheckBox.new(each.getName())
			checkBox.addActionListener(ToggleSwitchAction.new(each))
			pPanelSwitches.addWidget(checkBox)
		end)
	end
end
