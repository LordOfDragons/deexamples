pin Dragengine.Commands
pin Dragengine.Gui.Borders
pin Dragengine.Gui.Events
pin Dragengine.Gui.Layouts
pin Dragengine.Scenery
pin Dragengine.Utils
pin Dragengine.LoadSave



/**
 * \brief DragonScript test project edit bindings window.
 */
class WindowEditBindings extends Window
	/** \brief Log message. */
	class LogMessage implements ConsoleListener
		func new()
		end
		
		func void messageAdded(Console console, ConsoleMessage message, bool removedTop)
			BaseGameApp.getApp().getConsole().addMessage(message.getMessage())
		end
		
		func void consoleCleared(Console console)
		end
	end
	
	/** \brief Save bindings on BaseGameApp on window close listener. */
	class CloseSaveBindings extends DefaultWindowListener
		func new()
		end
		
		func void onWindowClosing(WindowEvent event)
			BaseGameApp.getApp().saveBindings()
		end
	end
	
	
	
	/** \brief Create window. */
	func new() super(0, 0, 700, 500)
		pConsole = Console.new(20)
		pConsole.addListener(LogMessage.new())
		
		setDesignerSelector("WindowPadding")
		setTitle("Edit Bindings")
		
		createCommandManager()
		createBindingManager()
		
		runWhileBlockingLayout(block
			createContent(this)
			addCommandsToModel()
		end)
		
		addWindowListener(CloseSaveBindings.new())
	end
	
	/** \brief Dispose of window. */
	func void dispose()
		pPanelEditBindings = null
		pBindingManager = null
		pCommandManager = null
		pConsole = null
		
		super.dispose()
	end
	
	
	var Console pConsole
	var BindingManager pBindingManager
	var CommandManager pCommandManager
	var EditBindingsPanel pPanelEditBindings
	
	
	/** \brief Create content. */
	private func void createContent(Container content)
		content.setLayout(BorderLayout.new(5))
		
		pPanelEditBindings = EditBindingsPanel.new(pBindingManager)
		addWidget(pPanelEditBindings, BorderLayout.Area.content)
	end
	
	
	/** \brief Create command manager with some dummy commands doing nothing. */
	func void createCommandManager()
		var int i
		
		pCommandManager = CommandManager.new()
		
		pCommandManager.add(Command.new("forward", "Move forward"))
		pCommandManager.add(Command.new("backward", "Move backward"))
		pCommandManager.add(Command.new("analogForwardBackward", "Analog move forward/backward"))
		pCommandManager.add(Command.new("moveRight", "Move right"))
		pCommandManager.add(Command.new("moveLeft", "Move left"))
		pCommandManager.add(Command.new("analogHorizontal", "Analog move left/right"))
		pCommandManager.add(Command.new("lookUp", "Look up"))
		pCommandManager.add(Command.new("lookDown", "Look down"))
		pCommandManager.add(Command.new("analogLookVertical", "Analog look up/down"))
		pCommandManager.add(Command.new("lookLeft", "Look left"))
		pCommandManager.add(Command.new("lookRight", "Look right"))
		pCommandManager.add(Command.new("analogLookHorizontal", "Analog look left/right"))
		pCommandManager.add(Command.new("jump", "Jump"))
		pCommandManager.add(Command.new("crouch", "Crouch"))
		pCommandManager.add(Command.new("use", "Use object"))
		pCommandManager.add(Command.new("switchGadget", "Cycle through gadgets (axis use)"))
		pCommandManager.add(Command.new("nextGadget", "Switch to next gadget"))
		pCommandManager.add(Command.new("prevGadget", "Switch to previous gadget"))
		for i = 0 to 10
			pCommandManager.add(Command.new("quickUse" + (i+1), "Quick Use " + (i+1)))
		end
		for i = 0 to 5
			pCommandManager.add(Command.new("action" + (i+1), "Action " + (i+1)))
		end
		pCommandManager.add(Command.new("load", "Load game"))
		pCommandManager.add(Command.new("save", "Save game"))
		pCommandManager.add(Command.new("quit", "Quit game"))
	end
	
	/** \brief Create binding manager with some dummy bindings. */
	func void createBindingManager()
		// create binding manager and update lookup. this initializes the device listing so
		// we can try to come up with some reasonable example bindings
		pBindingManager = BindingManager.new()
		
		// to add reasonable default bindings you can use DefaultBindingHelper. all the
		// bind* methods return true if all requested bindings have been added. combined
		// with *clear methods this can be used to try out different layouts if present.
		// usually the most simple solution is to assign a set of bindings which seem
		// reasonable no matter if they are all properly bound or not. after all the user
		// is going to edit the bindings anyways
		var DefaultBindingHelper helper = DefaultBindingHelper.new(\
			pBindingManager, pCommandManager)
		
		// if mouse and keyboard is present add some bindings for them
		if helper.hasMouse()
			helper.mouseBindMove("analogLookHorizontal", "analogLookVertical")
			helper.mouseBindWheel(0, "switchGadget")
			helper.mouseBindLMR("use", "action2", "action1")
		end
		
		if helper.hasKeyboard()
			helper.keyboardBindKeyCode(InputEventKey.arrowUp, "forward")
			helper.keyboardBindKeyCode(InputEventKey.arrowDown, "backward")
			helper.keyboardBindKeyCode(InputEventKey.arrowRight, "moveRight")
			helper.keyboardBindKeyCode(InputEventKey.arrowLeft, "moveLeft")
			
			helper.keyboardBindKeyCode(InputEventKey.i, "lookUp")
			helper.keyboardBindKeyCode(InputEventKey.k, "lookDown")
			helper.keyboardBindKeyCode(InputEventKey.j, "lookLeft")
			helper.keyboardBindKeyCode(InputEventKey.l, "lookRight")
			
			helper.keyboardBindKeyCode(InputEventKey.space, "jump")
			helper.keyboardBindKeyCode(InputEventKey.o, "crouch")
			
			helper.keyboardBindKeyCode(InputEventKey.digit1, "quickUse1")
			helper.keyboardBindKeyCode(InputEventKey.digit2, "quickUse2")
			helper.keyboardBindKeyCode(InputEventKey.digit3, "quickUse3")
			
			helper.keyboardBindKeyCode(InputEventKey.q, "quit")
		end
		
		// if there is a gamepad attached add some bindings
		if helper.hasGamepad()
			helper.gamepadBindStick(0, "analogHorizontal", "analogForwardBackward")
			helper.gamepadBindStick(1, "analogLookHorizontal", "analogLookVertical")
			
			helper.gamepadBindHat(0, null, "switchGadget")
			
			helper.gamepadBindButton(0, "use")
			helper.gamepadBindButton(1, "jump")
			helper.gamepadBindButton(2, "crouch")
			helper.gamepadBindButton(3, "action1")
		end
		
		// apply all the found bindings
		helper.updateBindingManager(true)
	end
	
	/** \brief Add commands to edit to edit bindings model. */
	func void addCommandsToModel()
		var Array list = Array.new()
		var int i
		
		list.add(EditBindingsListModelEntry.new(\
			pCommandManager.getNamed("forward"), \
			EditBindingsListModelEntry.InputSource.button))
		list.add(EditBindingsListModelEntry.new(\
			pCommandManager.getNamed("backward"), \
			EditBindingsListModelEntry.InputSource.button))
		list.add(EditBindingsListModelEntry.new(\
			pCommandManager.getNamed("analogForwardBackward"), \
			EditBindingsListModelEntry.InputSource.axis))
		list.add(EditBindingsListModelEntry.new(\
			pCommandManager.getNamed("moveRight"), \
			EditBindingsListModelEntry.InputSource.button))
		list.add(EditBindingsListModelEntry.new(\
			pCommandManager.getNamed("moveLeft"), \
			EditBindingsListModelEntry.InputSource.button))
		list.add(EditBindingsListModelEntry.new(\
			pCommandManager.getNamed("analogHorizontal"), \
			EditBindingsListModelEntry.InputSource.axis))
		
		list.add(EditBindingsListModelEntry.new(\
			pCommandManager.getNamed("lookUp"), \
			EditBindingsListModelEntry.InputSource.button))
		list.add(EditBindingsListModelEntry.new(\
			pCommandManager.getNamed("lookDown"), \
			EditBindingsListModelEntry.InputSource.button))
		list.add(EditBindingsListModelEntry.new(\
			pCommandManager.getNamed("analogLookVertical"), \
			EditBindingsListModelEntry.InputSource.axis))
		list.add(EditBindingsListModelEntry.new(\
			pCommandManager.getNamed("lookLeft"), \
			EditBindingsListModelEntry.InputSource.button))
		list.add(EditBindingsListModelEntry.new(\
			pCommandManager.getNamed("lookRight"), \
			EditBindingsListModelEntry.InputSource.button))
		list.add(EditBindingsListModelEntry.new(\
			pCommandManager.getNamed("analogLookHorizontal"), \
			EditBindingsListModelEntry.InputSource.axis))
		
		list.add(EditBindingsListModelEntry.new(\
			pCommandManager.getNamed("jump"), \
			EditBindingsListModelEntry.InputSource.button))
		list.add(EditBindingsListModelEntry.new(\
			pCommandManager.getNamed("crouch"), \
			EditBindingsListModelEntry.InputSource.button))
		list.add(EditBindingsListModelEntry.new(\
			pCommandManager.getNamed("use"), \
			EditBindingsListModelEntry.InputSource.button))
		for i = 0 to 10
			list.add(EditBindingsListModelEntry.new(\
				pCommandManager.getNamed("quickUse" + (i+1)), \
				EditBindingsListModelEntry.InputSource.button))
		end
		for i = 0 to 5
			list.add(EditBindingsListModelEntry.new(\
				pCommandManager.getNamed("action" + (i+1)), \
				EditBindingsListModelEntry.InputSource.button))
		end
		list.add(EditBindingsListModelEntry.new(\
			pCommandManager.getNamed("switchGadget"), \
			EditBindingsListModelEntry.InputSource.button))
		
		list.add(EditBindingsListModelEntry.new(\
			pCommandManager.getNamed("load"), \
			EditBindingsListModelEntry.InputSource.button))
		list.add(EditBindingsListModelEntry.new(\
			pCommandManager.getNamed("save"), \
			EditBindingsListModelEntry.InputSource.button))
		list.add(EditBindingsListModelEntry.new(\
			pCommandManager.getNamed("quit"), \
			EditBindingsListModelEntry.InputSource.button))
		
		pPanelEditBindings.getModel().addAll(list)
	end
end
